{
  "DefaultProvider": "Gemini",
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE",
    "Model": "gemini-flash-lite-latest"
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o-mini"
  },
  "Batching": {
    "DefaultBatchSize": 15,
    "DefaultOverlapPages": 1,
    "SmallDocThreshold": 4,
    "SmallDocBatchSize": 4,
    "SmallDocOverlapPages": 0
  },
  "Verification": {
    "ReviewThreshold": 0.70,
    "UnverifiedPenalty": 0.15
  },
  "ConnectionStrings": {
    "DocumentIntelligence": "Host=localhost;Port=5432;Database=pixous_doc_intelligence;Username=postgres;Password=YOUR_POSTGRES_PASSWORD_HERE"
  },
  "Storage": {
    "Provider": "PostgreSql",
    "OutputBaseDirectory": "output"
  },
  "PortalAuth": {
    "GoogleClientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com",
    "JwtSigningKey": "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG",
    "JwtIssuer": "PixousDocIntelligence",
    "JwtAudience": "PixousDocIntelligencePortal",
    "JwtExpiryMinutes": 10080,
    "AdminEmails": [ "YOUR_EMAIL@gmail.com" ]
  }
}
