# ==========================================
# Pixous Document Intelligence - Deployment Env
# ==========================================

# Database Configuration
POSTGRES_DB=pixous_doc_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# AI Models & Providers
DEFAULT_PROVIDER=Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Portal Authentication & Security
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
JWT_SIGNING_KEY=a-fresh-random-secret-at-least-32-characters-long
ADMIN_EMAILS=your-admin@email.com
